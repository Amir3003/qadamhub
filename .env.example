# Copy the names you need into .env in the repository root. Keep your own values private.
NEBIUS_API_KEY=
TAVILY_API_KEY=
# Optional: change if the default model is not enabled for your Nebius account.
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Optional for local development only. The deployed site reads public/data/opportunities.json.
VITE_QADAM_API_URL=http://127.0.0.1:8787

# Only newly issued bot credentials. Do not use the credentials previously committed to GitHub.
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=QadamAgentBot
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
DISCORD_INVITE_URL=
WEB_APP_URL=https://www.qadamhub.com
# Optional override: bots read https://www.qadamhub.com/data/opportunities.json by default.
RADAR_DATA_URL=

# Shared network: public client credentials only (never service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legal pages (optional, public). Unset values are not shown; the operator defaults to "QADAM Hub".
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_REGISTRATION_ID=
VITE_CONTACT_EMAIL=
# Server only: https webhook (for example a Discord channel webhook) that receives data requests
# from the Privacy page. Without it the form offers email instead.
DATA_REQUEST_WEBHOOK_URL=
 # Neon staging: public HTTPS base URL; never place a database password in VITE_ variables.
VITE_NEON_URL=
# Server-only database connection string, used to store feedback.
NEON_DATABASE_URL=
# Server-only: restricted role that can execute qadam_private.submit_public_form.
NEON_FORMS_DATABASE_URL=
# Server-only random secret, at least 32 characters, used to hash client IPs.
FORMS_IP_HASH_SECRET=
