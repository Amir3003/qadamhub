{
  "name": "qadam-opportunity-hub",
  "description": "QADAM («Қадам») — AI Opportunity & Career Hub for Global Grants, Hackathons, and Technologies.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build",
    "preview": "vite preview",
    "api": "node --env-file=.env backend/server.mjs serve",
    "scan": "node --env-file=.env backend/server.mjs scan",
    "bot": "node --env-file=.env bot/index.mjs",
    "bot:discord": "node --env-file=.env bot/discord.mjs",
    "discord:setup": "node --env-file=.env bot/discord-setup.mjs",
    "bot:all": "concurrently \"npm run bot\" \"npm run bot:discord\"",
    "test:network": "node --test tests/network-db.test.mjs tests/network-social.test.mjs",
    "test:feedback": "node --test tests/feedback.test.mjs",
    "test:network-ui": "playwright test --config playwright.network.config.ts",
    "check:quizzes": "node scripts/check-quizzes.mjs",
    "test:ui": "playwright test --config playwright.smoke.config.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "check:catalog": "node scripts/check-catalog.mjs",
    "test:bot": "node --test tests/bot-notify.test.mjs tests/bot-telegram.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.51.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@sentry/react": "^10.76.2",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  }
}
